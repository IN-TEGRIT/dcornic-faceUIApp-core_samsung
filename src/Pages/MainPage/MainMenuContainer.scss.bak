.main-menu-grid-container {
  display: grid;
  // width: calc(100vw + 15.1vw);
  // padding-left: 2.22vh;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  grid-template-columns: repeat(4, 0.25fr);
  grid-template-rows: 0.5fr 0.25fr 0.25fr;
  gap: 1.8vh;

  grid-template-areas:
		"m1 m1 m2 m2"
		"m3 m3 m6 m7"
  	"m4 m5 m6 m7"
  ;

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
}